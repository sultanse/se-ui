{
  "name": "se-ui",
  "version": "0.0.1",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    "./index.css": "./dist/style.css",
    "./index": null,
    "./*": {
      "types": "./dist/components/ui/*.d.ts",
      "import": "./dist/entries/*.js",
      "require": "./dist/entries/*.cjs"
    }
  },
  "sideEffects": [
    "./dist/*.css"
  ],
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite --config playground/vite.config.ts",
    "site:dev": "vite --config playground/vite.config.ts",
    "site:build": "tsc -p playground/tsconfig.json --noEmit && vite build --config playground/vite.config.ts",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/assert-package.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "^4",
    "shadcn": "^4.21.0",
    "@eslint/js": "^10",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.5",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "input-otp": "^1.5.0",
    "react": "^19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.6",
    "react-resizable-panels": "^4.12.3",
    "recharts": "3.8.0",
    "tailwindcss": "^4",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vite-plugin-dts": "^5.1.0",
    "tw-animate-css": "^1.4.0"
  }
}
